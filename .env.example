# Copy to .env and fill in real values. Never commit .env. Server-only — do not
# prefix any of these with VITE_ or they will be bundled into the browser build.

# Neon PostgreSQL connection string (persistent admin + public content).
DATABASE_URL=your_neon_postgresql_connection_string

# Vercel Blob read/write token (image/file storage).
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token

# Initial admin account. Seeded on first boot if no admin exists.
# Password must be at least 12 characters. Stored only as a bcrypt hash.
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Session signing/idle secret. At least 32 characters in production.
SESSION_SECRET=

# Optional runtime settings.
PORT=4173
NODE_ENV=production
